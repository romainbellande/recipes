    cursor: pointer;
  }
  button:focus-visible,
  a:focus-visible,
  input:focus-visible {
    outline: 3px solid #005fcc;
    outline-offset: 3px;
  }
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: white;
    padding: 0.75rem;
  }
  .skip-link:focus {
    top: 1rem;
  }
  .site-header,
  main,
  footer {
    max-width: 76rem;
    margin: auto;
    padding: 1.25rem 2rem;
  }
  .site-header,
  footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: system-ui, sans-serif;
  }
  .site-header a {
    font-weight: 800;
    text-decoration: none;
  }
  main {
    padding-top: 2rem;
  }
  .collection {
    display: grid;
    gap: 1rem;
  }
  .filters {
    max-width: 44rem;
  }
  .search-label,
  .tag-filters {
    display: block;
    margin: 1rem 0 0.5rem;
    font-family: system-ui, sans-serif;
    font-weight: 700;
  }
  #recipe-search {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid #6b5d53;
  }
  .tag-filters {
    border: 0;
    padding: 0;
  }
  .tag-filters label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.35rem 1rem 0.35rem 0;
    font-weight: 400;
  }
  #collection-results {
    margin: 0;
    font-family: system-ui, sans-serif;
  }
  #empty-state {
    margin: 0;
  }
  #reset-filters {
    border: 1px solid #803c20;
    background: transparent;
    color: #803c20;
    padding: 0.5rem 0.75rem;
  }
  .recipe-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .recipe-card {
    display: block;
    background: #fff;
    color: inherit;
    text-decoration: none;
  }
  .card-image,
  .image-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 12rem;
  }
  .card-image {
    object-fit: cover;
  }
  .image-placeholder {
    display: grid;
    place-items: center;
    background: #e9dfd3;
    color: #6b5d53;
    font-family: system-ui, sans-serif;
  }
  .card-content {
    padding: 1.25rem;
  }
  .card-content p {
    line-height: 1.45;
  }
  .card-meta {
    margin: 0;
    color: #6b5d53;
    font-family: system-ui, sans-serif;
  }
  .card-meta {
    font-size: 0.85rem;
    font-weight: 700;
  }
  .card-content h2 {
    margin: 0.5rem 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.05;
  }
  footer {
    border-top: 1px solid #d9cec2;
    margin-top: 4rem;
    font-size: 0.9rem;
    flex-wrap: wrap;
  }
  .eyebrow {
    margin: 0;
    color: #7b4b32;
    font:
      700 0.75rem system-ui,
      sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 720px) {
    .site-header,
    main,
    footer {
      padding-left: 1rem;
      padding-right: 1rem;
    }
    .card-image,
    .image-placeholder {
      min-height: 0;
    }
  }
  /* Editorial collection layer */
  :root {
    --paper: #f8f3ea;
    --paper-deep: #eee4d5;
    --ink: #29231d;
    --muted: #71675c;
    --line: #d9cdbc;
    --accent: #9e4229;
    --leaf: #5b6c51;
    color: var(--ink);
    background: var(--paper);
    font-family: "Newsreader", Georgia, serif;
  }
  body {
    background:
      radial-gradient(
        circle at 90% 0%,
        rgb(214 190 150 / 35%),
        transparent 24rem
      ),
      var(--paper);
  }
  .site-header,
  main,
  footer {
    max-width: 78rem;
  }
  .site-header {
    align-items: baseline;
    border-bottom: 1px solid var(--line);
    padding-top: 1.75rem;
    padding-bottom: 1rem;
  }
  .site-header a {
    font:
      600 clamp(1.5rem, 3vw, 2rem) / 1 "Newsreader",
      Georgia,
      serif;
  }
  .site-header span,
  footer {
    color: var(--muted);
    font:
      500 0.78rem / 1.4 "DM Sans",
      sans-serif;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  main {
    padding-top: clamp(2.5rem, 6vw, 5.5rem);
  }
  .collection {
    gap: 1.5rem;
  }
  .collection > * {
    min-width: 0;
  }
  .eyebrow {
    color: var(--accent);
    font-family: "DM Sans", sans-serif;
    letter-spacing: 0.14em;
  }
  .collection h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.87;
  }
  .filters {
    display: grid;
    gap: 0.65rem;
    max-width: 52rem;
    margin-top: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--line);
    background: rgb(255 253 248 / 65%);
  }
  .search-label,
  .tag-filters {
    margin: 0;
    color: var(--ink);
    font:
      700 0.72rem / 1.2 "DM Sans",
      sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  #recipe-search {
    border: 0;
    border-bottom: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    padding: 0.85rem 0 0.65rem;
    font:
      400 clamp(1.05rem, 2vw, 1.3rem) "Newsreader",
      Georgia,
      serif;
  }
  #recipe-search::placeholder {
    color: #978b7c;
  }
  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }
  .tag-filters legend {
    width: 100%;
    margin-bottom: 0.1rem;
  }
  .tag-filters label {
    margin: 0;
    border: 1px solid var(--line);
    padding: 0.45rem 0.65rem;
    color: var(--muted);
    font:
      500 0.78rem / 1 "DM Sans",
      sans-serif;
    transition:
      background 160ms ease,
      color 160ms ease;
  }
  .tag-filters input {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
  }
