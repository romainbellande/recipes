---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { readFileSync } from "node:fs";
import { durationInSeconds } from "../../scripts/collection.js";
const durationMinutes = (value: string) => {
  const hours = Number(value.match(/(\d+) h/)?.[1] ?? 0);
  const minutes = Number(value.match(/(\d+) min/)?.[1] ?? 0);
  return hours * 60 + minutes;
};
const displayDuration = (minutes: number) =>
  `${minutes >= 60 ? `${Math.floor(minutes / 60)} h${minutes % 60 ? ` ${minutes % 60} min` : ""}` : `${minutes} min`}`;

export async function getStaticPaths() {
  return (await getCollection("recipes")).flatMap((recipe) => [
    { params: { id: recipe.id }, props: { recipe } },
    ...(recipe.data.aliases ?? []).map((id) => ({
      params: { id },
      props: { recipe, isAlias: true },
    })),
  ]);
}

interface Props {
  recipe: CollectionEntry<"recipes">;
  isAlias?: boolean;
}

const recipeParts = (body: string) => {
  const [ingredientsPart = "", methodPart = ""] =
    body.split(/^## Préparation\s*$/m);
  return {
    ingredients: ingredientsPart
      .replace(/^## Ingrédients\s*$/m, "")
      .trim()
      .split("\n")
      .filter((line) => line.startsWith("- "))
      .map((line) => line.slice(2)),
    steps: methodPart
      .trim()
      .split("\n")
      .filter((line) => /^\d+\. /.test(line))
      .map((line) => ({ text: line.replace(/^\d+\. /, "") })),
  };
};

const { recipe, isAlias = false } = Astro.props;
const prepMinutes = durationMinutes(recipe.data.prep_time);
const cookMinutes = durationMinutes(recipe.data.cook_time);
const canonicalUrl = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/recipe/${recipe.id}/`,
  Astro.url,
);
const { Content } = await render(recipe);
const recipeIcon = readFileSync(
  `public/icons/recipes/${recipe.id}.svg`,
  "utf8",
);
const serializedRecipe = JSON.stringify({
  title: recipe.data.title,
  servings: Number(recipe.data.servings),
  nutrition: recipe.data.nutrition,
  timers: (recipe.data.timers ?? []).map((timer) => ({
    ...timer,
    seconds: durationInSeconds(timer.duration),
  })),
  prep_time_display: displayDuration(prepMinutes),
  cook_time_display: displayDuration(cookMinutes),
  total_time_display: displayDuration(prepMinutes + cookMinutes),
  ...recipeParts(recipe.body ?? ""),
}).replace(/</g, "\\u003c");
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#9e4229" />
    <link
      rel="manifest"
      href={`${import.meta.env.BASE_URL}/manifest.webmanifest`}
    />
    <link
      rel="apple-touch-icon"
      href={`${import.meta.env.BASE_URL}/icons/pwa-192.png`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={recipe.data.summary} />
    <link rel="canonical" href={canonicalUrl.href} />
    {
      isAlias && (
        <script is:inline>
          window.location.replace( `$
          {document.querySelector('link[rel="canonical"]').pathname}$
          {window.location.search}${window.location.hash}`, );
        </script>
      )
    }
    <title>{recipe.data.title} | Recettes</title>
  </head>
  <body>
    <header>
      <a href={import.meta.env.BASE_URL}>Recettes</a>
      <span>Cuisine du quotidien</span>
    </header>
    <main id="recipe-view">
      <a
        id="return-link"
        class="return-link"
        data-origin-card={`recipe-${recipe.id}`}
        href={import.meta.env.BASE_URL}>← Retour à la Collection</a
      >
      <div class="recipe-visual" aria-hidden="true" set:html={recipeIcon} />
      <article>
        <h1 id="recipe-title" tabindex="-1">{recipe.data.title}</h1>
        <p class="summary">{recipe.data.summary}</p>
        <div class="servings-control">
          <label for="recipe-servings">Nombre de personnes</label>
          <span class="servings-stepper">
            <button
              type="button"
              data-servings-change="-1"
              aria-label="Diminuer le nombre de personnes">−</button
            >
            <input
              id="recipe-servings"
              type="number"
              min="1"
              step="1"
              value={recipe.data.servings}
            />
            <button
              type="button"
              data-servings-change="1"
              aria-label="Augmenter le nombre de personnes">+</button
            >
          </span>
        </div>
        <p id="print-servings">Pour {recipe.data.servings} personnes</p>
        <p class="recipe-time">
          <span>Préparation&nbsp;<b>{displayDuration(prepMinutes)}</b></span>
          <span aria-hidden="true">·</span>
          <span>Cuisson&nbsp;<b>{displayDuration(cookMinutes)}</b></span>
          <span aria-hidden="true">·</span>
          <span
            >Total&nbsp;<b>{displayDuration(prepMinutes + cookMinutes)}</b
            ></span
          >
        </p>
        <div class="recipe-actions">
          <button class="primary" type="button" id="enter-cook">
            Passer en mode cuisine
          </button>
          <div class="recipe-secondary-actions">
            <button
              class="icon-button"
              type="button"
              id="enter-shopping"
              aria-label="Voir la liste de courses"
              data-tooltip="Voir la liste de courses"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M9 6h11M9 12h11M9 18h11M3 6l1.5 1.5L7 4M3 12l1.5 1.5L7 10M3 18l1.5 1.5L7 16"
                ></path>
              </svg>
            </button>
            <button
              class="icon-button"
              type="button"
              id="print-recipe"
              aria-label="Imprimer ou enregistrer en PDF"
              data-tooltip="Imprimer ou enregistrer en PDF"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 9V3h12v6M6 18H4V9h16v9h-2M6 14h12v7H6z"></path>
              </svg>
            </button>
            <button
              class="icon-button"
              type="button"
              id="copy-recipe-link"
              aria-label="Copier le lien"
              data-tooltip="Copier le lien"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1"
                ></path>
              </svg>
            </button>
            <p id="copy-status" class="copy-status" aria-live="polite"></p>
          </div>
        </div>
        <div id="recipe-content"><Content /></div>
        <section class="nutrition" aria-labelledby="nutrition-title">
          <h2 id="nutrition-title">Valeurs nutritionnelles</h2>
          <p class="nutrition-note">
            Estimation générée par IA à partir des données de <a
              href="https://fdc.nal.usda.gov/">USDA FoodData Central</a
            > — valeurs indicatives.
          </p>
          <div
            class="nutrition-tabs"
            role="group"
            aria-label="Unité des valeurs nutritionnelles"
          >
            <button
              type="button"
              aria-pressed="true"
              data-nutrition-view="serving">Par portion</button
            >
            <button
              type="button"
              aria-pressed="false"
              data-nutrition-view="100g">Pour 100 g</button
            >
          </div>
          <dl id="nutrition-values" aria-live="polite"></dl>
        </section>
      </article>
    </main>
    <main class="shopping-mode" id="shopping-view" hidden>
      <button class="text-button" type="button" id="exit-shopping"
        >← Retour à la Recette</button
      >
      <section aria-labelledby="shopping-title">
        <p class="eyebrow">Liste de courses</p>
        <h1 id="shopping-title"></h1>
        <div class="servings-control">
          <label for="shopping-servings">Nombre de personnes</label>
          <span class="servings-stepper">
            <button
              type="button"
              data-servings-change="-1"
              aria-label="Diminuer le nombre de personnes">−</button
            >
            <input id="shopping-servings" type="number" min="1" step="1" />
            <button
              type="button"
              data-servings-change="1"
              aria-label="Augmenter le nombre de personnes">+</button
            >
          </span>
        </div>
        <ul id="shopping-ingredients"></ul>
      </section>
    </main>
    <main class="cook-mode" id="cook-view" hidden>
      <button class="text-button" type="button" id="exit-cook"
        >← Quitter le mode cuisine</button
      >
      <section class="cook-layout" aria-labelledby="cook-title">
        <aside>
          <p class="eyebrow">En cuisine</p>
          <h1 id="cook-title"></h1>
          <div class="servings-control">
            <label for="cook-servings">Nombre de personnes</label>
            <span class="servings-stepper">
              <button
                type="button"
                data-servings-change="-1"
                aria-label="Diminuer le nombre de personnes">−</button
              >
              <input id="cook-servings" type="number" min="1" step="1" />
              <button
                type="button"
                data-servings-change="1"
                aria-label="Augmenter le nombre de personnes">+</button
              >
            </span>
          </div>
          <p class="recipe-time cook-time" id="cook-time"></p>
          <details id="cook-ingredients-disclosure">
            <summary>Ingrédients</summary>
            <ul id="cook-ingredients"></ul>
          </details>
        </aside>
        <section class="current-step" aria-live="polite">
          <p class="eyebrow" id="step-count"></p>
          <h2 id="step-title"></h2>
          <p id="step-text"></p>
          <div id="step-timer"></div>
          <div class="step-actions">
            <button type="button" id="previous-step" hidden
              >Étape précédente</button
            >
            <button class="primary" type="button" id="next-step"></button>
          </div>
        </section>
        <aside class="timers-rail">
          <div class="cook-timers-panel">
            <button
              type="button"
              id="rail-toggle"
              class="rail-toggle"
              aria-expanded="false"
              aria-controls="cook-timers"
            >
              <span class="rail-toggle-icon" aria-hidden="true"></span>
              <span id="rail-summary"></span>
              <span class="rail-chevron" aria-hidden="true"></span>
            </button>
            <h2 class="cook-timers-title" id="timers-title">Minuteries</h2>
            <section id="cook-timers" aria-label="Minuteries actives"></section>
          </div>
          <p id="timer-live" class="sr-only" aria-live="polite"></p>
        </aside>
      </section>
    </main>
    <footer>
      Contenu des Recettes © contributeurs de Recettes, sous licence <a
        href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a
      >. Les modifications doivent être indiquées. <a
        href="https://github.com/romainbellande/recipes">Source</a
      >
    </footer>
    <script is:inline src={`${import.meta.env.BASE_URL}/pwa.js`}></script>
    <script
      is:inline
      id="recipe-json"
      type="application/json"
      set:html={serializedRecipe}
    />
    <script>
      // @ts-nocheck
      import {
        collectionFiltersFromSearch,
        appendInlineRecipeMarkup,
        collectionSearchParams,
        scaleIngredient,
        setInlineRecipeMarkup,
      } from "../../scripts/collection.js";

      const recipe = JSON.parse(
        document.querySelector("#recipe-json").textContent,
      );
      let selectedServings = recipe.servings;
      let step = 0;
      let timers = [];
      let timerId = 0;
      let copyStatusTimer;
      let audioContext;
      const recipeView = document.querySelector("#recipe-view");
      const shopping = document.querySelector("#shopping-view");
      const cook = document.querySelector("#cook-view");
      const recipeServings = document.querySelector("#recipe-servings");
      const shoppingServings = document.querySelector("#shopping-servings");
      const cookServings = document.querySelector("#cook-servings");
      const printServings = document.querySelector("#print-servings");
      const decrementButtons = document.querySelectorAll(
        '[data-servings-change="-1"]',
      );
      const recipeIngredients = [
        ...document.querySelectorAll("#recipe-content h2"),
      ].find(
        (heading) => heading.textContent === "Ingrédients",
      ).nextElementSibling;
      const shoppingTitle = document.querySelector("#shopping-title");
      const shoppingIngredients = document.querySelector(
        "#shopping-ingredients",
      );
      const title = document.querySelector("#cook-title");
      const ingredients = document.querySelector("#cook-ingredients");
      const ingredientsDisclosure = document.querySelector(
        "#cook-ingredients-disclosure",
      );
      const count = document.querySelector("#step-count");
      const stepTitle = document.querySelector("#step-title");
      const stepText = document.querySelector("#step-text");
      const stepTimer = document.querySelector("#step-timer");
      const cookTimers = document.querySelector("#cook-timers");
      const timersRail = document.querySelector(".timers-rail");
      const railToggle = document.querySelector("#rail-toggle");
      const railSummary = document.querySelector("#rail-summary");
      let railCollapsed = true;
      const previous = document.querySelector("#previous-step");
      const next = document.querySelector("#next-step");
      const exitCook = document.querySelector("#exit-cook");
      const validServings = (value) =>
        /^\d+$/.test(value) &&
        Number.isSafeInteger(Number(value)) &&
        Number(value) > 0;

      const updateDecrementButtons = () =>
        decrementButtons.forEach((button) => {
          button.disabled = selectedServings === 1;
        });

      function updateServings(value) {
        if (!validServings(value)) return;
        selectedServings = Number(value);
        updateDecrementButtons();
        recipeServings.value = selectedServings;
        shoppingServings.value = selectedServings;
        cookServings.value = selectedServings;
        printServings.textContent = `Pour ${selectedServings} personne${selectedServings > 1 ? "s" : ""}`;
        recipeIngredients
          .querySelectorAll("li")
          .forEach((item, index) =>
            setInlineRecipeMarkup(
              item,
              scaleIngredient(
                recipe.ingredients[index],
                recipe.servings,
                selectedServings,
              ),
            ),
          );
        [shoppingIngredients, ingredients].forEach((list) =>
          list.querySelectorAll("label").forEach((label, index) => {
            const check = label.querySelector("input");
            label.replaceChildren(check, " ");
            appendInlineRecipeMarkup(
              label,
              scaleIngredient(
                recipe.ingredients[index],
                recipe.servings,
                selectedServings,
              ),
            );
          }),
        );
      }

      const nutritionValues = document.querySelector("#nutrition-values");
      let nutritionView = "serving";
      const nutritionFields = [
        ["Énergie (kJ)", "energy_kj", "kJ"],
        ["Énergie (kcal)", "energy_kcal", "kcal"],
        ["Matières grasses", "fat_g", "g"],
        ["dont acides gras saturés", "saturates_g", "g"],
        ["Glucides", "carbohydrates_g", "g"],
        ["dont sucres", "sugars_g", "g"],
        ["Fibres alimentaires", "fibre_g", "g"],
        ["Protéines", "protein_g", "g"],
        ["Sel", "salt_g", "g"],
      ];
      const formatNutrition = (value, unit) =>
        `${new Intl.NumberFormat("fr-FR", {
          maximumFractionDigits: unit === "g" ? 1 : 0,
        }).format(value)} ${unit}`;
      // One portion is always one serving of the recipe as authored; the
      // servings selector scales ingredients only, not nutrition values.
      function renderNutrition() {
        const multiplier =
          nutritionView === "100g"
            ? 1
            : recipe.nutrition.weight_g / 100 / recipe.servings;
        nutritionValues.replaceChildren(
          ...nutritionFields.flatMap(([label, field, unit]) => {
            const term = document.createElement("dt");
            term.textContent = label;
            const value = document.createElement("dd");
            value.textContent = formatNutrition(
              recipe.nutrition[field] * multiplier,
              unit,
            );
            return [term, value];
          }),
        );
      }

      const formatTime = (seconds) =>
        `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`;

      function prepareAlarm() {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        audioContext ??= new AudioContext();
        audioContext.resume();
      }

      function playAlarm() {
        if (!audioContext) return;
        const start = audioContext.currentTime;
        for (const [index, frequency] of [523.25, 659.25, 783.99].entries()) {
          const oscillator = audioContext.createOscillator();
          const gain = audioContext.createGain();
          const when = start + index * 0.18;
          oscillator.type = "sine";
          oscillator.frequency.value = frequency;
          gain.gain.setValueAtTime(0.001, when);
          gain.gain.exponentialRampToValueAtTime(0.12, when + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.001, when + 0.16);
          oscillator.connect(gain).connect(audioContext.destination);
          oscillator.start(when);
          oscillator.stop(when + 0.17);
        }
      }

      function renderTimers() {
        const now = Date.now();
        for (const timer of timers) {
          if (!timer.finished && timer.endsAt <= now) {
            timer.finished = true;
            timer.lastAlarmAt = now;
            playAlarm();
          } else if (timer.finished && now - timer.lastAlarmAt >= 1_000) {
            timer.lastAlarmAt = now;
            playAlarm();
          }
        }
        timersRail.hidden = timers.length === 0;
        // Collapsed strip shows the soonest-ending running timer.
        const soonest = timers
          .filter((t) => !t.finished)
          .sort((a, b) => a.endsAt - b.endsAt)[0];
        if (soonest) {
          const remaining = formatTime(
            Math.max(0, Math.ceil((soonest.endsAt - now) / 1000)),
          );
          railSummary.replaceChildren(
            document.createTextNode(`${soonest.title} · `),
            (() => {
              const strong = document.createElement("b");
              strong.textContent = remaining;
              return strong;
            })(),
          );
        }
        railToggle.setAttribute("aria-expanded", String(!railCollapsed));
        cookTimers.replaceChildren(
          ...timers.map((timer) => {
            const item = document.createElement("div");
            item.className = "cook-timer";
            const remaining = Math.max(
              0,
              Math.ceil((timer.endsAt - now) / 1000),
            );
            const title = document.createElement("span");
            title.className = "cook-timer-title";
            title.textContent = timer.title;
            const count = document.createElement("span");
            count.className = "cook-timer-count";
            count.textContent = timer.finished
              ? "terminé"
              : formatTime(remaining);
            title.setAttribute("aria-hidden", "true");
            count.setAttribute("aria-hidden", "true");
            const stop = document.createElement("button");
            stop.type = "button";
            stop.textContent = timer.finished ? "Arrêter l’alarme" : "Arrêter";
            stop.addEventListener("click", () => {
              timers = timers.filter(({ id }) => id !== timer.id);
              renderTimers();
            });
            item.append(title, count, stop);
            return item;
          }),
        );
      }

      function showStep(index) {
        step = index;
        const currentStep = recipe.steps[step];
        count.textContent = `Étape ${step + 1} sur ${recipe.steps.length}`;
        stepTitle.textContent = "Étape en cours";
        setInlineRecipeMarkup(stepText, currentStep.text);
        stepTimer.replaceChildren(
          ...recipe.timers
            .filter((timer) => timer.step === step + 1)
            .map((timer) => {
              const control = document.createElement("div");
              control.className = "timer-control";
              const duration = document.createElement("input");
              duration.type = "number";
              duration.min = "1";
              duration.step = "1";
              duration.value = String(timer.seconds / 60);
              duration.setAttribute(
                "aria-label",
                `Durée de ${timer.title} en minutes`,
              );
              const start = document.createElement("button");
              start.type = "button";
              start.className = "clock-button";
              start.setAttribute("aria-label", `Démarrer ${timer.title}`);
              start.innerHTML = '<span aria-hidden="true"></span>';
              start.addEventListener("click", () => {
                const minutes = Number(duration.value);
                if (!Number.isInteger(minutes) || minutes < 1) return;
                prepareAlarm();
                timers.push({
                  id: timerId++,
                  title: timer.title,
                  endsAt: Date.now() + minutes * 60_000,
                  finished: false,
                });
                renderTimers();
              });
              const label = document.createElement("label");
              label.textContent = `${timer.title} — `;
              label.append(duration, " min");
              control.append(label, start);
              return control;
            }),
        );
        previous.hidden = step === 0;
        next.textContent =
          step === recipe.steps.length - 1
            ? "Terminer la Recette"
            : "Étape suivante";
      }

      function resetCook() {
        timers = [];
        railCollapsed = true;
        timersRail.classList.remove("collapsed");
        renderTimers();
        showStep(0);
        ingredients.querySelectorAll("input").forEach((input) => {
          input.checked = false;
        });
      }

      function enterShopping() {
        shoppingTitle.textContent = recipe.title;
        shoppingServings.value = selectedServings;
        shoppingIngredients.replaceChildren(
          ...recipe.ingredients.map((item) => {
            const li = document.createElement("li");
            const label = document.createElement("label");
            const check = document.createElement("input");
            check.type = "checkbox";
            label.append(check, " ");
            appendInlineRecipeMarkup(
              label,
              scaleIngredient(item, recipe.servings, selectedServings),
            );
            li.append(label);
            return li;
          }),
        );
        recipeView.hidden = true;
        shopping.hidden = false;
        window.scrollTo(0, 0);
        document.querySelector("#exit-shopping").focus();
      }

      function enterCook() {
        title.textContent = recipe.title;
        timersRail.classList.toggle("collapsed", railCollapsed);
        // Open the ingredient disclosure on wide screens (persistent column);
        // keep it closed on mobile so the current step stays front-and-center.
        ingredientsDisclosure.open =
          window.matchMedia("(min-width: 721px)").matches;
        const cookTime = document.querySelector("#cook-time");
        cookTime.replaceChildren(
          ...[
            ["Préparation", recipe.prep_time_display],
            ["Cuisson", recipe.cook_time_display],
            ["Total", recipe.total_time_display],
          ].flatMap(([label, value], index) => {
            const out = [];
            if (index > 0) {
              const sep = document.createElement("span");
              sep.setAttribute("aria-hidden", "true");
              sep.textContent = "·";
              out.push(sep);
            }
            const span = document.createElement("span");
            span.textContent = `${label} `;
            const b = document.createElement("b");
            b.textContent = value;
            span.append(b);
            out.push(span);
            return out;
          }),
        );
        cookServings.value = selectedServings;
        ingredients.replaceChildren(
          ...recipe.ingredients.map((item) => {
            const li = document.createElement("li");
            const label = document.createElement("label");
            const check = document.createElement("input");
            check.type = "checkbox";
            label.append(check, " ");
            appendInlineRecipeMarkup(
              label,
              scaleIngredient(item, recipe.servings, selectedServings),
            );
            li.append(label);
            return li;
          }),
        );
        recipeView.hidden = true;
        cook.hidden = false;
        showStep(0);
        window.scrollTo(0, 0);
        exitCook.focus();
      }

      const timerLive = document.querySelector("#timer-live");
      const formatLive = (t) =>
        t.finished
          ? `${t.title} terminé`
          : `${t.title} : ${formatTime(Math.max(0, Math.ceil((t.endsAt - Date.now()) / 1000)))}`;
      const announceTimers = () => {
        const msg = timers.length
          ? timers.map(formatLive).join(", ")
          : "Aucune minuterie active";
        if (timerLive.textContent !== msg) timerLive.textContent = msg;
      };
      setInterval(renderTimers, 250);
      setInterval(announceTimers, 1000);

      railToggle.addEventListener("click", () => {
        railCollapsed = !railCollapsed;
        timersRail.classList.toggle("collapsed", railCollapsed);
        renderTimers();
        if (railCollapsed) railToggle.focus();
      });

      updateDecrementButtons();
      renderNutrition();
      document.querySelectorAll("[data-nutrition-view]").forEach((tab) =>
        tab.addEventListener("click", () => {
          nutritionView = tab.dataset.nutritionView;
          document
            .querySelectorAll("[data-nutrition-view]")
            .forEach((other) =>
              other.setAttribute("aria-pressed", String(other === tab)),
            );
          renderNutrition();
        }),
      );
      document
        .querySelectorAll("[data-servings-change]")
        .forEach((button) =>
          button.addEventListener("click", () =>
            updateServings(
              String(selectedServings + Number(button.dataset.servingsChange)),
            ),
          ),
        );
      recipeServings.addEventListener("input", () =>
        updateServings(recipeServings.value),
      );
      shoppingServings.addEventListener("input", () =>
        updateServings(shoppingServings.value),
      );
      cookServings.addEventListener("input", () =>
        updateServings(cookServings.value),
      );
      document
        .querySelector("#enter-shopping")
        .addEventListener("click", enterShopping);
      document
        .querySelector("#print-recipe")
        .addEventListener("click", () => window.print());
      const copyRecipeLink = document.querySelector("#copy-recipe-link");
      const copyStatus = document.querySelector("#copy-status");
      copyRecipeLink.addEventListener("click", async () => {
        const copied = "Lien copié";
        const failed = "Impossible de copier le lien";
        try {
          await navigator.clipboard.writeText(
            document.querySelector('link[rel="canonical"]').href,
          );
          copyStatus.textContent = copied;
        } catch {
          copyStatus.textContent = failed;
        }
        clearTimeout(copyStatusTimer);
        copyStatusTimer = setTimeout(() => {
          copyStatus.textContent = "";
        }, 3_000);
      });
      document
        .querySelector("#enter-cook")
        .addEventListener("click", enterCook);
      previous.addEventListener("click", () => showStep(step - 1));
      next.addEventListener("click", () =>
        step === recipe.steps.length - 1
          ? exitCook.click()
          : showStep(step + 1),
      );
      document.querySelector("#exit-shopping").addEventListener("click", () => {
        shopping.hidden = true;
        recipeView.hidden = false;
        document.querySelector("#enter-shopping").focus();
      });
      exitCook.addEventListener("click", () => {
        resetCook();
        cook.hidden = true;
        recipeView.hidden = false;
        recipeServings.focus();
      });

      const returnLink = document.querySelector("#return-link");
      const filters = collectionFiltersFromSearch(window.location.search);
      const query = collectionSearchParams(filters).toString();
      returnLink.href = `${import.meta.env.BASE_URL}${query ? `?${query}` : ""}#${returnLink.dataset.originCard}`;
      document.querySelector("#recipe-title").focus();
    </script>
  </body>
</html>

